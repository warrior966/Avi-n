rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Cada usuario puede leer su propio perfil. No se permite cambiar roles desde la web.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /flights/{flightId} {
      // El panel público puede consultar los vuelos.
      allow read: if true;
      // Solo usuarios cuyo documento users/{uid} tenga role == "admin".
      allow create, update, delete: if isAdmin();
    }
  }
}